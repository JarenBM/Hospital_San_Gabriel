# SIGIH - Plantilla de configuracion
# ---------------------------------------------------------------------------
# El repositorio ya incluye backend/.env con valores de desarrollo.
# Use esta plantilla solo si necesita recrear ese archivo o preparar un
# entorno distinto (por ejemplo, produccion).
# ---------------------------------------------------------------------------

# Conexion a SQL Server (instancia local, sin puerto explicito)
DB_SERVER=.\SQLEXPRESS
DB_NAME=SIGIH
DB_DRIVER=ODBC Driver 18 for SQL Server

# Credenciales del usuario de aplicacion
# Debe coincidir con la contrasena definida en database/INSTALAR_SIGIH.sql
DB_USER=sigih_app
DB_PASSWORD=

# Autenticacion JWT
# Generar con: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=60
