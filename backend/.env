# SIGIH - Configuracion de desarrollo
# ---------------------------------------------------------------------------
# Este archivo SI se versiona: es un proyecto academico y debe funcionar al
# clonar el repositorio, sin editar nada.
#
# Los valores son solo para uso local. NO usarlos en un despliegue real.
# Si el proyecto se publica en un servidor, genere un JWT_SECRET nuevo y
# cambie la contrasena de sigih_app.
#
# La contrasena de DB_PASSWORD debe coincidir con la definida en
# database/INSTALAR_SIGIH.sql (variable @password).
# ---------------------------------------------------------------------------

# Conexion a SQL Server (instancia local, sin puerto explicito)
DB_SERVER=.\SQLEXPRESS
DB_NAME=SIGIH
DB_DRIVER=ODBC Driver 18 for SQL Server

# Credenciales del usuario de aplicacion creado por el instalador SQL
DB_USER=sigih_app
DB_PASSWORD=Sigih.App.2026!

# Autenticacion JWT
JWT_SECRET=EChZNEbWQaCHGl8_9Vqsd0qk2arM15PGm0BfxiEa-H0j6pMhBdaFON5yf4FNalHo
JWT_EXPIRACION_MINUTOS=60
